PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/mock_test_canvas?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Google OAuth 2.0 Credentials (for Google Sign-In)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# Cloudinary (for violation snapshot uploads and question diagrams)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Google Gemini AI (for Question Paper Document/Image/PDF Ingestion)
# Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional: Transactional Email Service for OTP verification & alerts
# Option A: Resend API (Recommended)
# RESEND_API_KEY=re_your_resend_api_key_here
# EMAIL_FROM="Mock Test Canvas" <onboarding@resend.dev>

# Option B: Brevo API
# BREVO_API_KEY=your_brevo_api_key_here

# Option C: Standard SMTP (Gmail, etc.)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=465
# EMAIL_SECURE=true
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=your_gmail_app_password
# EMAIL_FROM="Mock Test Canvas" <your_email@gmail.com>
