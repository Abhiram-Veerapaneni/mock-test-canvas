# Production API Base URL (Deployed on Render)
VITE_API_BASE_URL=https://mock-test-canvas.onrender.com/api

# For Local Development with local server:
# VITE_API_BASE_URL=http://localhost:5000/api

# Frontend Application URL (Deployed on Vercel)
VITE_FRONTEND_URL=https://mock-test-canvas.vercel.app

# Google OAuth 2.0 Client ID (must match backend GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
