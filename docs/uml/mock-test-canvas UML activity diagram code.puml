@startuml
title Mock Test Canvas Activity Diagram

' =========================
' COMPACT STYLING
' =========================

skinparam dpi 110
skinparam shadowing false
skinparam activity {
    BackgroundColor #FFFFFF
    BorderColor #1A73E8
    FontSize 10
    Padding 3
}
skinparam activityDiamondBackgroundColor #FFFFFF
skinparam activityDiamondBorderColor #1A73E8

skinparam partition {
    BackgroundColor #F8F9FA
    BorderColor #BDC1C6
    FontSize 10
    Padding 2
}

skinparam arrow {
    Color #5F6368
    FontSize 9
}

' =========================
' EXAM START
' =========================

|#E8F0FE| Candidate |

start
:Browse Exam Catalog;
:Select Exam;
:Click "Start Examination";

|#F4F6F8| Backend API & DB |

:Receive startAttempt Request;

if (Max Attempts Exceeded?) then (Yes)
    :Return 403 Attempt Limit Reached;

    |Candidate|
    :Display Error;
    :Return to Catalog;
    stop

else (No)
    :Initialize / Retrieve Attempt;
    :Set status = IN_PROGRESS;
endif

' =========================
' PROCTORING PRE-CHECK
' =========================

|#E8F0FE| Candidate |

:Enter Proctoring Pre-Check Gate;

|#F4F6F8| Client React App & AI Proctor |

:Request Camera & Microphone;
:Request Fullscreen Lockdown;

if (System Pre-Check Passed?) then (No)

    |Candidate|
    :Show System Check Failure;
    stop

else (Yes)

    :Launch ExamPlayer;
    :Start Precision Countdown;

endif

' =========================
' EXAM SESSION
' =========================

|Candidate|

fork

    ' ---- Candidate Flow ----

    repeat
        :Navigate Questions;
        :Input Answers;
        :Mark for Review;
    repeat while (Exam Session Active?) is (Yes)

fork again

    ' ---- Proctoring Flow ----

    |#F4F6F8| Client React App & AI Proctor |

    repeat

        :Monitor Webcam;
        :Monitor Audio;
        :Monitor Browser Lockdown;

        if (Violation Detected?) then (Yes)

            :Capture Snapshot;
            :Send Violation Payload;

            |#F4F6F8| Backend API & DB |

            :Deduct Trust Score (-15);
            :Store Violation Record;
            :Broadcast violation:live;

            |#FFFFFF| Examiner / Dashboard |

            :Receive Live Violation Alert;

            |#F4F6F8| Backend API & DB |

            if (Strikes >= Max OR Trust Score = 0?) then (Yes)

                :Set Attempt = DISQUALIFIED;

                |#E8F0FE| Candidate |

                :Display Disqualification;
                :Lock Exam Player;
                stop

            else (No)

                |Candidate|
                :Display Strike Warning;

            endif

        endif

    repeat while (Exam Session Active?) is (Yes)

end fork

' =========================
' SUBMISSION & GRADING
' =========================

|#E8F0FE| Candidate |

:Submit Exam OR Timer = 00:00;

|#F4F6F8| Backend API & DB |

:Receive submitExam Request;
:Execute gradeAttempt();

:Calculate Score;
:Calculate Accuracy;
:Count Correct / Incorrect;

:Update Attempt = SUBMITTED;
:Record submittedAt;

:Emit Socket.IO Submission Notification;

' =========================
' RESULTS
' =========================

|#E8F0FE| Candidate |

:View Graded Result;
:View Performance Analytics;

|#FFFFFF| Examiner / Dashboard |

:Inspect Audit Report;
:View Snapshot Timeline;

stop

@enduml