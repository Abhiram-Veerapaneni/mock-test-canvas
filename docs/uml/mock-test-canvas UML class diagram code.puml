@startuml
title Mock Test Canvas Class Diagram

skinparam class {
    BackgroundColor #FFFFFF
    BorderColor #1A73E8
    ArrowColor #3C4043
    HeaderBackgroundColor #E8F0FE
}
skinparam package {
    BackgroundColor #F8F9FA
    BorderColor #BDC1C6
}
skinparam shadowing false
skinparam monochrome false

package "Database Models (Mongoose Schemas)" {
    class User <<Model>> {
        +ObjectId _id
        +String name
        +String email
        +String password
        +String googleId
        +String authProvider
        +String avatar
        +ObjectId[] createdTests
        +AttemptedExam[] attemptedTests
        +matchPassword(enteredPassword): Boolean
    }

    class Exam <<Model>> {
        +ObjectId _id
        +String title
        +String description
        +String category
        +String status
        +ObjectId creatorId
        +Number durationMinutes
        +Number totalMarks
        +Number maxAttempts
        +MarkingScheme markingScheme
        +ObjectId[] questions
        +ProctorSettings proctorSettings
    }

    class Question <<Model>> {
        +ObjectId _id
        +String questionText
        +String questionType
        +String imageAttachment
        +Mixed[] options
        +Number[] correctAnswers
        +String explanation
        +String subject
        +String topic
        +Boolean isEdited
    }

    class Attempt <<Model>> {
        +ObjectId _id
        +ObjectId examId
        +ObjectId userId
        +ResponseItem[] responses
        +Number score
        +Number accuracy
        +Number correct
        +Number incorrect
        +Number unanswered
        +Number trustScore
        +ViolationItem[] violations
        +String status
        +Date startedAt
        +Date submittedAt
    }

    class Notification <<Model>> {
        +ObjectId _id
        +ObjectId recipient
        +ObjectId sender
        +String type
        +String title
        +String message
        +Object data
        +String link
        +Boolean read
    }

    class MarkingScheme <<Subdocument>> {
        +Number correct
        +Number incorrect
    }

    class ProctorSettings <<Subdocument>> {
        +Boolean faceCheck
        +Boolean audioCheck
        +Boolean fullScreenLock
        +Boolean liveNotifications
        +Boolean objectCheck
        +Number maxWarningsAllowed
    }

    class ResponseItem <<Subdocument>> {
        +ObjectId questionId
        +Number[] selectedAnswers
        +String status
        +Number timeSpentSeconds
    }

    class ViolationItem <<Subdocument>> {
        +Date timestamp
        +String type
        +String imageUrl
    }
}

package "Backend Controllers & Services" {
    class AuthController <<Controller>> {
        +register(req, res): Promise
        +login(req, res): Promise
        +googleAuth(req, res): Promise
        +getMe(req, res): Promise
    }

    class ExamController <<Controller>> {
        +createExam(req, res): Promise
        +getAllExams(req, res): Promise
        +getExamById(req, res): Promise
        +updateExam(req, res): Promise
        +uploadExamMedia(req, res): Promise
        +getExamViolations(req, res): Promise
    }

    class SubmissionController <<Controller>> {
        +startAttempt(req, res): Promise
        +submitExam(req, res): Promise
        +getUserAttempts(req, res): Promise
        +logViolation(req, res): Promise
    }

    class AIController <<Controller>> {
        +ingestDocument(req, res): Promise
    }

    class GeminiService <<Service>> {
        +extractQuestionsFromPdf(buffer): Promise
        +extractQuestionsFromText(text): Promise
        +extractQuestionsFromImage(buffer, mime): Promise
    }

    class GradingService <<Service>> {
        +gradeAttempt(answers, questions, markingScheme): Object
    }
}

package "Frontend State & Proctoring Engine" {
    class useProctorStore <<Zustand Store>> {
        +Array violations
        +Number trustScore
        +Number strikeCount
        +String activeExamId
        +addViolation(type, customDeduction): Boolean
        +resetProctor(examId): void
    }

    class useExamStore <<Zustand Store>> {
        +Object activeExam
        +Object answers
        +Object visitedQuestions
        +Object markedForReview
        +setAnswer(qId, selected): void
        +toggleMarkForReview(qId): void
    }

    class useVisionProctor <<Custom Hook>> {
        +Boolean isModelLoaded
        +detectFrame(videoRef, canvasRef): void
    }

    class useAudioProctor <<Custom Hook>> {
        +Boolean isAudioActive
        +listenAmbientNoise(stream): void
    }

    class useBrowserLockdown <<Custom Hook>> {
        +Boolean isFullscreen
        +requestLockdown(): void
        +releaseLockdown(): void
    }
}

' Domain Model Relationships
User "1" *-- "*" Exam : creatorId / createdTests
Exam "1" o-- "*" Question : questions
User "1" *-- "*" Attempt : userId
Exam "1" *-- "*" Attempt : examId
Attempt "1" *-- "*" ResponseItem : responses
Attempt "1" *-- "*" ViolationItem : violations
Exam "1" *-- "1" MarkingScheme : markingScheme
Exam "1" *-- "1" ProctorSettings : proctorSettings
User "1" *-- "*" Notification : recipient

' Controller & Service Dependencies
ExamController ..> Exam : manipulates
ExamController ..> Question : creates
SubmissionController ..> Attempt : manages
SubmissionController ..> GradingService : invokes
AIController ..> GeminiService : delegates ingestion

' Client Subsystem Dependencies
useVisionProctor ..> useProctorStore : triggers addViolation()
useAudioProctor ..> useProctorStore : triggers addViolation()
useBrowserLockdown ..> useProctorStore : triggers addViolation()
useExamStore ..> SubmissionController : posts submitExam()

@startuml
