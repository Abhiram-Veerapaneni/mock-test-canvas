PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/ai_proctored_mock_tests?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key
# Environment (development locally, production on Render)
NODE_ENV=development

# Allowed Frontend URL (http://localhost:5173 locally, https://ai-proctored-mock-tests.vercel.app on Render)
CLIENT_URL=http://localhost:5173

# SMTP Email Configuration (Optional - for sending real OTP emails to candidate inboxes)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM="AI-Proctored Mock Tests" <your_email@gmail.com>
