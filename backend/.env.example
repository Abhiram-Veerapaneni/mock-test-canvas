PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/ai_proctored_mock_tests?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key
# Environment (development locally, production on Render)
NODE_ENV=development

# Allowed Frontend URL (http://localhost:5173 locally, https://ai-proctored-mock-tests.vercel.app on Render)
CLIENT_URL=http://localhost:5173

# HTTP Email API Configuration (Recommended for Render / Cloud Hosts over HTTPS Port 443)
# Brevo (300 free emails/day) - https://brevo.com
BREVO_API_KEY=xkeysib-your_brevo_api_key_here

# Resend (3,000 free emails/month) - https://resend.com
# RESEND_API_KEY=re_your_resend_api_key_here

# SMTP Email Configuration (Optional - for local testing)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM="AI-Proctored Mock Tests" <your_email@gmail.com>

